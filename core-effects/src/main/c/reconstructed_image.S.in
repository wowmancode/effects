/* The reconstructed DSP's original data layout, embedded read-only. At run
   time reconstructed_pitch.c copies it to read/write, non-executable memory at
   0x180000000; it is never executed. Generated by CMake from
   reconstructed_image.S.in so the path below is absolute. */
.section .rodata
.global lift_image_start
.global lift_image_end
lift_image_start:
.incbin "@RECON_IMAGE@"
lift_image_end:
.section .note.GNU-stack,"",%progbits
